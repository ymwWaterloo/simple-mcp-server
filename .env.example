# Example environment variables
# Copy this file to .env and adjust the values according to your environment

# Transport type: "stdio" (default) or "http"/"sse"
TRANSPORT=http

# Port for HTTP mode (only applies if TRANSPORT=http)
PORT=3000

# Path to the CSV file where tasks are saved (directory or file)
# If not specified, the default is {project-root}/tasks.csv
# Example: .  or  /path/to/your/project
TASKS_CSV_PATH=.

# Execution environment
NODE_ENV=development
