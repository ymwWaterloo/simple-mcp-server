{
  "name": "simple-mcp-server",
  "version": "1.0.0",
  "description": "MCP server template with stdio and Streamable HTTP transports. Use as a starting point for your own MCP projects.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "TRANSPORT=stdio node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "TRANSPORT=stdio tsx watch src/index.ts",
    "dev:http": "TRANSPORT=http tsx watch src/index.ts",
    "example:stdio": "node examples/client-stdio.js",
    "example:http": "node examples/client-http.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "server",
    "template"
  ],
  "author": "John Gallo (https://github.com/jgallo1994)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgallo1994/simple-mcp-server.git"
  },
  "bugs": "https://github.com/jgallo1994/simple-mcp-server/issues",
  "homepage": "https://github.com/jgallo1994/simple-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
